// ============================================================
// REGRAS DE SEGURANÇA DO FIRESTORE — ECOMAP
// ============================================================
//
// COMO APLICAR:
//
// OPÇÃO A — Firebase CLI (recomendado):
//   1. Instale a CLI: npm install -g firebase-tools
//   2. Login: firebase login
//   3. Inicie o projeto (se ainda não fez): firebase init firestore
//      - Quando perguntar o arquivo de regras, aponte para este arquivo
//   4. Publique: firebase deploy --only firestore:rules
//
// OPÇÃO B — Console Firebase (mais rápido para testes):
//   1. Acesse https://console.firebase.google.com
//   2. Selecione o projeto "ecomap"
//   3. No menu lateral: Firestore Database → Regras
//   4. Substitua o conteúdo pelo bloco "rules_version" abaixo
//   5. Clique em "Publicar"
//
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // COLEÇÃO: reportes
    // ----------------------------------------------------------
    match /reportes/{reporteId} {

      // Qualquer usuário autenticado pode ler todos os reportes
      allow read: if request.auth != null;

      // Apenas autenticado pode criar, e o donoId deve ser o próprio uid
      allow create: if request.auth != null
        && request.resource.data.donoId == request.auth.uid;

      // Atualização permitida em dois casos:
      //   1. O dono do reporte pode alterar qualquer campo
      //      (confirmar coleta → Resolvido, cancelar coleta → Pendente)
      //   2. Qualquer autenticado pode "coletar": muda status Pendente → Em Coleta
      //      mas não pode alterar donoId nem outros campos sensíveis
      allow update: if request.auth != null && (
        // Caso 1: dono do reporte
        resource.data.donoId == request.auth.uid
        ||
        // Caso 2: coletor reivindicando um reporte pendente
        (
          resource.data.status == 'Pendente'
          && request.resource.data.status == 'Em Coleta'
          && request.resource.data.coletorId == request.auth.uid
          && request.resource.data.donoId == resource.data.donoId
        )
      );

      // Apenas o dono pode deletar
      allow delete: if request.auth != null
        && resource.data.donoId == request.auth.uid;
    }

    // ----------------------------------------------------------
    // COLEÇÃO: usuarios
    // ----------------------------------------------------------
    match /usuarios/{userId} {

      // Qualquer autenticado pode ler perfis (para exibir nome do coletor/dono)
      allow read: if request.auth != null;

      // Cada usuário só pode escrever no próprio documento
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
